# --- Local dev uses SQLite by default: leave DATABASE_URL unset and it just works ---
# DATABASE_URL=sqlite:///./helmsman.db

# --- Phase 5: Azure SQL (SQL Server). Get the base string from Azure Portal > your DB > Connection strings > ODBC ---
# DATABASE_URL=mssql+pyodbc://USER:PASSWORD@SERVER.database.windows.net:1433/DBNAME?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no

# Comma-separated frontend origins allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173

# --- JWT signing key (Phase 3 auth). Dev has an insecure hardcoded fallback so
# --- `uvicorn --reload` still works with zero setup. Set a real random value in
# --- production, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
# SECRET_KEY=change-me-in-production
